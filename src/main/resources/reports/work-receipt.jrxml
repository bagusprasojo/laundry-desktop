<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="work_receipt"
              pageWidth="595"
              pageHeight="420"
              orientation="Landscape"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail"
              uuid="99b379ff-8f4a-4a20-9721-4d8adcb8ab41">

    <parameter name="businessName" class="java.lang.String"/>
    <parameter name="businessAddress" class="java.lang.String"/>
    <parameter name="businessPhone" class="java.lang.String"/>
    <parameter name="printedAt" class="java.lang.String"/>

    <field name="invoiceNo" class="java.lang.String"/>
    <field name="orderDate" class="java.lang.String"/>
    <field name="customerName" class="java.lang.String"/>
    <field name="serviceName" class="java.lang.String"/>
    <field name="speedName" class="java.lang.String"/>
    <field name="unitName" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Double"/>
    <field name="unitPrice" class="java.lang.Integer"/>
    <field name="totalPrice" class="java.lang.Integer"/>
    <field name="paidAmount" class="java.lang.Integer"/>
    <field name="paymentMethod" class="java.lang.String"/>
    <field name="paymentStatus" class="java.lang.String"/>
    <field name="orderStatus" class="java.lang.String"/>
    <field name="estimateDone" class="java.lang.String"/>
    <field name="note" class="java.lang.String"/>

    <title>
        <band height="110">
            <textField>
                <reportElement x="0" y="2" width="320" height="22"/>
                <textElement>
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessName}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="26" width="320" height="18"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{businessAddress}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="46" width="320" height="16"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Telp: " + $P{businessPhone}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="390" y="2" width="165" height="24"/>
                <textElement textAlignment="Right">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[NOTA TERIMA]]></text>
            </staticText>
            <textField>
                <reportElement x="355" y="30" width="200" height="16"/>
                <textElement textAlignment="Right">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Cetak: " + $P{printedAt}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="78" width="555" height="1"/>
            </line>
        </band>
    </title>

    <detail>
        <band height="238">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="238"/>
            </rectangle>

            <staticText>
                <reportElement x="12" y="12" width="120" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[No Invoice]]></text>
            </staticText>
            <textField>
                <reportElement x="135" y="12" width="180" height="16"/>
                <textFieldExpression><![CDATA[$F{invoiceNo}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="330" y="12" width="95" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Tanggal Terima]]></text>
            </staticText>
            <textField>
                <reportElement x="430" y="12" width="113" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{orderDate}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="12" y="34" width="120" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Pelanggan]]></text>
            </staticText>
            <textField>
                <reportElement x="135" y="34" width="408" height="16"/>
                <textFieldExpression><![CDATA[$F{customerName}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="12" y="57" width="531" height="1"/>
            </line>

            <staticText>
                <reportElement x="12" y="66" width="100" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Layanan]]></text>
            </staticText>
            <textField>
                <reportElement x="115" y="66" width="160" height="16"/>
                <textFieldExpression><![CDATA[$F{serviceName}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="283" y="66" width="80" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Kecepatan]]></text>
            </staticText>
            <textField>
                <reportElement x="365" y="66" width="178" height="16"/>
                <textFieldExpression><![CDATA[$F{speedName}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="12" y="88" width="100" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Satuan]]></text>
            </staticText>
            <textField>
                <reportElement x="115" y="88" width="160" height="16"/>
                <textFieldExpression><![CDATA[$F{unitName}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="283" y="88" width="80" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <textField pattern="#,##0.###">
                <reportElement x="365" y="88" width="178" height="16"/>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="12" y="116" width="100" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Harga Satuan]]></text>
            </staticText>
            <textField pattern="'Rp' #,##0">
                <reportElement x="115" y="116" width="160" height="16"/>
                <textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="283" y="116" width="80" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Current Total]]></text>
            </staticText>
            <textField pattern="'Rp' #,##0">
                <reportElement x="365" y="116" width="178" height="16"/>
                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{totalPrice}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="12" y="144" width="100" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Paid Amount]]></text>
            </staticText>
            <textField pattern="'Rp' #,##0">
                <reportElement x="115" y="144" width="160" height="16"/>
                <textFieldExpression><![CDATA[$F{paidAmount}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="283" y="144" width="80" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Sisa Bayar]]></text>
            </staticText>
            <textField pattern="'Rp' #,##0">
                <reportElement x="365" y="144" width="178" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[Math.max(0, ($F{totalPrice} == null ? 0 : $F{totalPrice}) - ($F{paidAmount} == null ? 0 : $F{paidAmount}))]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="12" y="166" width="100" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Status Bayar]]></text>
            </staticText>
            <textField>
                <reportElement x="115" y="166" width="160" height="16"/>
                <textFieldExpression><![CDATA[$F{paymentStatus}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="283" y="166" width="80" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
            <textField>
                <reportElement x="365" y="166" width="178" height="16"/>
                <textFieldExpression><![CDATA[$F{orderStatus}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="12" y="188" width="100" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Estimasi Selesai]]></text>
            </staticText>
            <textField>
                <reportElement x="115" y="188" width="428" height="16"/>
                <textFieldExpression><![CDATA[$F{estimateDone}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="12" y="208" width="100" height="16"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Keterangan]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement x="115" y="208" width="428" height="24"/>
                <textFieldExpression><![CDATA[$F{note} == null ? "-" : $F{note}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
